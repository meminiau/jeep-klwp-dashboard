<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHudContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg">

    <!-- Layer 1: Full-Screen Jeep Cyber HUD Wallpaper Artwork -->
    <ImageView
        android:id="@+id/ivHudBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_jeep_hud" />

    <!-- Layer 2: Live HUD Overlay (Clock, Date, Status, Gear Icon, 6 Sidebar Buttons, Frame Area) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hudOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glClockTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.028" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glClockBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.108" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glRailArrowEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.248" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glSidebarTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.165" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glSidebarBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.945" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glFrameStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.26" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glFrameEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.96" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glFrameTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.20" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glFrameBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.91" />

        <!-- Top-Left Live Status (Battery, BT, Wi-Fi) -->
        <TextView
            android:id="@+id/tvHudStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.04"
            android:textColor="#B8B8E4F7"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Discreet Settings Gear Icon (Top-Right Corner) -->
        <ImageButton
            android:id="@+id/btnSettingsGear"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:alpha="0.75"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="HUD Settings"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_gear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top HUD Clock & Date Inside Metallic Bezel -->
        <LinearLayout
            android:id="@+id/layoutClockBezel"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/glClockBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/glClockTop">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="03:27"
                android:textColor="#FFEAF7FF"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="Tuesday, 24 Nov"
                android:textColor="#FFC7E5F5"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Left Sidebar Column: 6 Equal-Weight HUD App Buttons -->
        <LinearLayout
            android:id="@+id/sidebarColumn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/glSidebarBottom"
            app:layout_constraintEnd_toEndOf="@id/glRailArrowEnd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/glSidebarTop">

            <include
                android:id="@+id/btnGemini"
                layout="@layout/item_hud_sidebar_button" />

            <include
                android:id="@+id/btnTorque"
                layout="@layout/item_hud_sidebar_button" />

            <include
                android:id="@+id/btnJellyfin"
                layout="@layout/item_hud_sidebar_button" />

            <include
                android:id="@+id/btnWaze"
                layout="@layout/item_hud_sidebar_button" />

            <include
                android:id="@+id/btnYouTube"
                layout="@layout/item_hud_sidebar_button" />

            <include
                android:id="@+id/btnYouTubeMusic"
                layout="@layout/item_hud_sidebar_button" />
        </LinearLayout>

        <!-- Right-Hand HUD Window Frame Touch Target (tap clears active highlight) -->
        <View
            android:id="@+id/viewHudFrameTouch"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/glFrameBottom"
            app:layout_constraintEnd_toEndOf="@id/glFrameEnd"
            app:layout_constraintStart_toStartOf="@id/glFrameStart"
            app:layout_constraintTop_toTopOf="@id/glFrameTop" />

        <!-- Subtle Bottom Swipe-Up App Drawer Handle -->
        <LinearLayout
            android:id="@+id/layoutDrawerHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/glFrameEnd"
            app:layout_constraintStart_toStartOf="@id/glFrameStart">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_drawer_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.14"
                android:text="▲  APPS"
                android:textColor="#9900E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Layer 3: Built-In Swipe-Up App Drawer Overlay -->
    <LinearLayout
        android:id="@+id/layoutAppDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app_drawer"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutDrawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_drawer_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="ALL APPS"
                    android:textColor="@color/hud_cyan"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDrawerSettings"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="HUD Settings"
                    android:textColor="@color/hud_cyan"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/hud_cyan" />

                <ImageButton
                    android:id="@+id/btnCloseDrawer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close App Drawer"
                    android:padding="7dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSearchApps"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hud_card"
                android:hint="Search installed apps..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/hud_text_primary"
                android:textColorHint="@color/hud_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap to open app  •  Long-press to launch in HUD window"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppDrawer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="24dp" />
    </LinearLayout>

</FrameLayout>
